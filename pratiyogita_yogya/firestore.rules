rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isEligibilityReader() {
      return isSignedIn() && request.auth.token.eligibility_reader == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profile and auth-sync docs (existing app behavior)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subPath=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Exam catalog and exam payloads (moved from public frontend JSON)
    match /examCatalog/{docId} {
      allow read: if isEligibilityReader();
      allow write: if false;
    }

    match /examData/{docId} {
      allow read: if isEligibilityReader();
      allow write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
