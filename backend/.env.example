# ============================================================
# Backend Environment Variables (.env.example)
# ============================================================
# 1) Copy this file to: backend/.env
# 2) Replace placeholder values with real secrets
# 3) Keep quotes OFF unless value contains spaces
# 4) Never commit backend/.env to git
# ============================================================

# =========================
# API KEYS (REQUIRED)
# =========================
# Pinecone is used by BOTH RAG answers and PYQ retrieval.
PINECONE_API_KEY=your_pinecone_api_key_here

# LLM routing
# Primary model provider for answer generation
OPENAI_API_KEY=your_openai_api_key_here
# Recommended low-cost default. Can be replaced with any compatible OpenAI chat model.
OPENAI_MODEL_NAME=gpt-4o-mini
# Request timeout (seconds) for OpenAI calls.
OPENAI_TIMEOUT_SECONDS=20

# Fallback provider if OpenAI fails / times out / rate-limits
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.1-8b-instant

# Optional Hugging Face key (only needed if USE_HF_EMBEDDINGS=1)
HF_API_KEY=your_hf_api_key_here

# =========================
# FLASK APP RUNTIME
# =========================
# Use production in deployment platforms (Railway/Render/etc.)
# FLASK_ENV=production
FLASK_ENV=development
FLASK_DEBUG=1
# Port the Flask app binds to
PORT=5000

# =========================
# CORS
# =========================
# Comma-separated frontend origins allowed to call backend APIs
# Example production:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://preview.your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================
# RAG (NCERT) - 768d
# =========================
# Must match your RAG Pinecone index name and dimension
RAG_INDEX_NAME=ncert-local-bge-base
RAG_INDEX_DIMENSION=768

# Embedding provider for RAG answer retrieval pipeline
# local = sentence-transformers loaded on server
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# cpu for low-resource servers, gpu if available
EMBEDDING_DEVICE=cpu

# =========================
# PYQ/MCQ - keep old 384d compatibility
# =========================
# IMPORTANT:
# Keep MCQ embedding model aligned with pyq-1 index dimension (typically 384).
# Do NOT switch this to bge-base unless pyq index is retrained/reindexed for 768.
MCQ_EMBEDDING_PROVIDER=local
MCQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MCQ_EMBEDDING_DEVICE=cpu

# =========================
# Optional embedding fallbacks
# =========================
# FastEmbed toggles (optional)
USE_FASTEMBED=0
FASTEMBED_MODEL=BAAI/bge-base-en-v1.5
USE_FASTEMBED_FOR_MCQ=0
FASTEMBED_MCQ_MODEL=BAAI/bge-small-en-v1.5

# HuggingFace inference toggles (optional)
# Set USE_HF_EMBEDDINGS=1 only if you want remote embeddings via HF API.
USE_HF_EMBEDDINGS=0
HF_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
HF_MCQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_PROVIDER=auto

# =========================
# Search / generation defaults
# =========================
# Number of top RAG chunks used for answer context
DEFAULT_N_RESULTS=5
# MCQ similarity filtering controls
DEFAULT_MCQ_THRESHOLD=0.25
DEFAULT_MCQ_LIMIT=0

# LLM response style defaults (can be overridden by frontend controls)
DEFAULT_ANSWER_TEMPERATURE=0.3
DEFAULT_ANSWER_TOP_P=0.9
DEFAULT_ANSWER_MAX_TOKENS=1200

# Embedding cache TTL in seconds
EMBEDDING_CACHE_TTL=600

# Optional app security setting
SECRET_KEY=your-secret-key-for-sessions